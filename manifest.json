{
  "manifest_version": 3,
  "name": "Chatscape: live ASCII wallpapers for claude.ai",
  "short_name": "Chatscape",
  "version": "0.1.0",
  "description": "Animated ASCII and pixel scenes behind your claude.ai chat. 20 themes, no account, nothing leaves your browser.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Chatscape themes",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "commands": {
    "toggle-picker": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open the theme picker"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/engine.js", "src/themes.js", "src/scanner.js", "src/picker.js", "src/main.js"],
      "css": ["src/page.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
